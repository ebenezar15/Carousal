{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window permissions: core APIs and HTTP limited to the Claude API and local servers (Ollama).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://api.anthropic.com/*"
        },
        {
          "url": "http://localhost:*/*"
        },
        {
          "url": "http://127.0.0.1:*/*"
        }
      ]
    }
  ]
}
