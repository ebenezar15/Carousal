{
  "version": 1,
  "notes": "Original style systems. Each style varies layout logic, typography treatment, background system and decoration, not only color. Font ids reference research/fonts.json, palette ids reference research/palettes.json, layout ids reference layoutCatalog below. Sizes are in px at a 1080px-wide canvas and scale proportionally.",
  "layoutCatalog": {
    "hook-giant-type": "Oversized headline filling 60-75% of the canvas, minimal subline, swipe cue bottom-right.",
    "hook-split": "Canvas split into two blocks (color or image / type); headline in one half.",
    "hook-centered": "Centered headline with small kicker above and subline below.",
    "hook-image-overlay": "Full-bleed image or graphic with gradient scrim and headline anchored bottom-left.",
    "hook-number": "Huge numeral (e.g. '7') as the visual anchor with headline beside or below.",
    "hook-tweet": "Post-style card: avatar, name, handle, text, optional metrics row.",
    "body-top-left": "Kicker + headline top-left, body below, generous whitespace right.",
    "body-card": "Content placed on a raised surface card over the background.",
    "body-two-column": "Headline left column, body right column (landscape and square only).",
    "body-centered": "Centered headline and body, symmetrical margins.",
    "body-icon-top": "Icon or illustration on top, headline, then body.",
    "list-bullets": "Headline then 3-5 bullets with custom markers.",
    "list-numbered-rows": "Numbered rows separated by rules.",
    "list-checklist": "Checkbox-style items.",
    "step-big-number": "Step number as giant numeral, step title, explanation.",
    "step-timeline": "Vertical timeline connecting steps with nodes.",
    "stat-hero": "One giant figure, label underneath, source line in small text.",
    "stat-chart": "Headline + bar/pie/line chart from data.",
    "quote-big-marks": "Large quotation marks, quote text, attribution.",
    "quote-card": "Quote on a surface card with attribution row.",
    "compare-split": "Before/after or A/B in two halves with labels.",
    "cta-centered": "Centered call to action, handle, save/share icons.",
    "cta-profile": "Avatar/logo, handle, follow prompt, secondary action.",
    "cta-recap": "Short recap list followed by call to action."
  },
